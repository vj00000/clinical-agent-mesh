# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM provider ---
OPENAI_API_KEY=sk-...
MESH_CHAT_MODEL=gpt-5-nano
MESH_EMBED_MODEL=text-embedding-3-small

# --- Retrieval ---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Checkpointer (falls back to in-memory when unset) ---
# POSTGRES_URL=postgresql://mesh:mesh@localhost:5432/mesh

# --- Observability (optional; tracing is skipped when unset) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000

# --- Routing behaviour ---
# Supervisor confidence below this routes to `clarify` instead of guessing.
MESH_ROUTE_CONFIDENCE_THRESHOLD=0.6
